---
import '../styles/global.css';
import NoticeBanner from '../components/NoticeBanner.astro';
import { site } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  /** Marks the current top-level nav item. */
  section?: 'guide' | 'troubleshooting';
}
const { title, section } = Astro.props;
const base = withBase();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title} · ChromeOS client certificates</title>
  </head>
  <body data-base={base}>
    <NoticeBanner />
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-title" href={base}>
          <svg class="site-logo-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span class="site-title-text">ChromeOS client certificates</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <a href={base} class="nav-link" aria-current={section === 'guide' ? 'page' : undefined}>Guide</a>
          <a href={withBase('troubleshooting/')} class="nav-link" aria-current={section === 'troubleshooting' ? 'page' : undefined}>Troubleshooting</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <p>Last updated {site.updated} · Tested with GCCC {site.gcccVersion}</p>
      <p><a href={site.repo} rel="noopener">Source &amp; issues on GitHub</a></p>
    </footer>
  </body>
</html>
