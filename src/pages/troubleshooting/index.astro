---
import Layout from '../../layouts/Layout.astro';
import ScratchpadPanel from '../../components/ScratchpadPanel.astro';
import OfficialLinks from '../../components/OfficialLinks.astro';
import ReportLink from '../../components/ReportLink.astro';
import { cardReportUrl } from '../../lib/report';
import { loadCards } from '../../lib/content';

const cards = await loadCards();
---
<Layout title="Troubleshooting" section="troubleshooting">
  <div class="layout">
    <aside class="sidebar" id="sidebar" aria-label="Sidebar">
      <ScratchpadPanel />
    </aside>

    <main class="content" id="main">
      <h1>Troubleshooting</h1>

      <p class="lead-text">Start on the device. Most problems show there first. Each section is plain text on one page, so your browser's find (Ctrl-F) works across all of them.</p>

      <p class="notice-na" data-paths-strict="VENDOR DIY">
        Sections 2 and 3 are specific to the Google Cloud Certificate Connector (GCCC), which your path does not use.
      </p>

      <h2>Sections</h2>
      <ul class="symptom-list">
        {cards.map(({ entry }) => (
          <li class="symptom-item" data-paths={entry.data.paths.join(' ')}>
            <a class="symptom-title" href={`#${entry.id}`}>{entry.data.title}</a>
          </li>
        ))}
      </ul>

      {cards.map(({ entry, Content }) => {
        return (
          <article class="card" id={entry.id} data-paths={entry.data.paths.join(' ')}>
            <header class="step-header">
              <h2>{entry.data.title}</h2>
            </header>
            <div class="prose"><Content /></div>
            <OfficialLinks links={entry.data.officialLinks} />
            <ReportLink href={cardReportUrl(entry.data.title)} label="Report a problem with this section" />
          </article>
        );
      })}
    </main>
  </div>
  <script>
    import '../../scripts/page';
  </script>
</Layout>
