---
import Layout from '../../layouts/Layout.astro';
import ScratchpadPanel from '../../components/ScratchpadPanel.astro';
import OfficialLinks from '../../components/OfficialLinks.astro';
import TroubleCard from '../../components/TroubleCard.astro';
import ReportLink from '../../components/ReportLink.astro';
import { cardReportUrl } from '../../lib/report';
import { loadCards } from '../../lib/content';
import { trees } from '../../data/troubleshooting';

const cards = await loadCards();
---
<Layout title="Troubleshooting" section="troubleshooting">
  <div class="layout">
    <aside class="sidebar" id="sidebar" aria-label="Sidebar">
      <ScratchpadPanel />
    </aside>

    <main class="content" id="main">
      <h1>Troubleshooting</h1>

      <p class="notice-na" data-paths-strict="VENDOR DIY">
        The troubleshooting here is specific to the Google Cloud Certificate Connector (GCCC), which your path does not use.
      </p>

      <div data-paths="SCEP">
        <p class="lead-text">Find your symptom, then work down its checks. Each card is plain text on one page, so your browser's find (Ctrl-F) works across all of them.</p>

        <h2>Symptoms</h2>
        <ul class="symptom-list">
          {cards.map(({ entry }) => (
            <li class="symptom-item">
              <a class="symptom-title" href={`#${entry.id}`}>{entry.data.title}</a>
            </li>
          ))}
        </ul>

        {cards.map(({ entry, Content }) => {
          const tree = trees[entry.id];
          return (
            <article class="card" id={entry.id}>
              <header class="step-header">
                <p class="step-kicker">Symptom</p>
                <h2>{entry.data.title}</h2>
              </header>
              <div class="prose"><Content /></div>
              {tree && (
                <section aria-label="Checks">
                  <h3>Checks, in order</h3>
                  <TroubleCard tree={tree} />
                </section>
              )}
              <OfficialLinks links={entry.data.officialLinks} />
              <ReportLink href={cardReportUrl(entry.data.title)} label="Report a problem with this card" />
            </article>
          );
        })}
      </div>
    </main>
  </div>
  <script>
    import '../../scripts/page';
  </script>
</Layout>
